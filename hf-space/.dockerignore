# =====================================================================
# Docker 빌드 시 이미지에 들어가지 말아야 할 것들
# (HF Space repo 루트에 같이 두면 Docker 가 자동 인식)
# =====================================================================

# 가상환경 — 컨테이너 안에서 다시 설치
**/venv/
**/.venv/
**/env/

# Python 캐시
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Node.js (백엔드는 빼지만 혹시라도 backend/ 일부에 남아있을 경우)
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# 학습 로그/체크포인트 (런타임에 다시 생성)
**/logs/
**/runs/
**/wandb/
**/.tb_logs/
**/full_train_all.log
**/rl_train_all.log
**/log_snapshot.txt

# 보고서 출력물 (런타임에 생성)
report-service/output/
ml-pipeline/data/cache/

# 프론트엔드 (HF엔 안 올림)
frontend/

# Node 백엔드 src (HF엔 backend/pipeline 만 필요)
backend/src/
backend/scripts/
backend/public/
backend/data/
backend/package.json
backend/package-lock.json
backend/node_modules/

# IDE / OS 메타
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# Git 자체 (Docker 빌드 시 .git 은 불필요 - LFS 통과는 별개로 해결됨)
.git/
.gitignore

# 환경변수 (HF Secrets 로 주입)
.env
**/.env
backend/.env

# HF Space 자체 메타
.huggingface/

# 임시/백업 파일
*.bak
*.tmp
*.log
*~
