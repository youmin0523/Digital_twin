# =====================================================================
# Arctic Digital Twin — 환경변수 템플릿
#
# 사용법:
#   * 로컬 테스트: 이 파일을 복사해서 .env 로 저장하고 값 채우기
#       cp .env.example .env
#   * HF Spaces:   Space → Settings → "Variables and secrets" 에 등록
#                  ⚠️ .env 파일은 commit 하지 말 것 (.gitignore 처리됨)
#
# 모든 키는 선택사항이지만, 비어있으면 해당 기능이 비활성화된다.
# =====================================================================


# ── Claude (Anthropic) API ───────────────────────────────────────────
# report-service 가 트렌드 보고서 생성 시 Claude 호출에 사용.
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ── Copernicus Marine (해양 데이터, 선택) ─────────────────────────────
# 가입: https://data.marine.copernicus.eu/register
# 해빙 농도 / 해류 / 수온 데이터를 자동 갱신하려면 필요.
# 비워두면 마지막에 캐시된 데이터로 동작.
COPERNICUS_MARINE_USER=your-email@example.com
COPERNICUS_MARINE_PASSWORD=your-password


# ── CDSE Sentinel-1 (SAR 빙산 아카이브, 선택) ─────────────────────────
# 가입: https://dataspace.copernicus.eu/
# SAR 영상 자동 다운로드/학습용. 비워두면 학습 스킵, 추론만 가능.
CDSE_USER=your-email@example.com
CDSE_PASSWORD=your-password


# ── 운영 옵션 (선택) ─────────────────────────────────────────────────
# CORS 화이트리스트 — 운영 단계에서 *  대신 본인 Vercel 도메인 권장.
# (현재 app.py 는 ["*"] 하드코딩. 좁히려면 코드 수정 필요)
# CORS_ALLOW_ORIGINS=https://your-frontend.vercel.app

# 외부 노출 포트 — HF Spaces 가 자동으로 7860 으로 설정.
# PORT=7860
